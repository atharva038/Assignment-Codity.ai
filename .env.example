# Distributed Job Scheduler - Environment Variables

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobs_db?schema=public"

# Redis Cache & PubSub Configuration
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# API Application Configuration
PORT=3000
NODE_ENV="development"
JWT_SECRET="super-secret-assignment-jwt-key-2026"

# Worker Node Configuration
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEARTBEAT_INTERVAL_MS=5000

# Scheduler Service Configuration
SCHEDULER_CHECK_INTERVAL_MS=5000
STALE_WORKER_TIMEOUT_MS=30000

# AI Failure Diagnostics (Supports OPENAI_API_KEY or GEMINI_API_KEY, fallback to Heuristic Engine)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
